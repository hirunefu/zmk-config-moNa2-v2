// キーマップは roBa（hirunefu/zmk-config-roBa の config/roBa.keymap）に合わせている。違いは次のとおり。
// - moNa2 は 42 キーで、roBa の左手内側 2 段目のキー（既定レイヤーの ESC）の位置にノブがある。
//   ESC は ARROW レイヤー（LANG1 長押し）の内側の TAB キーに移し、NUM レイヤーの同じ位置の Ctrl+Alt+0 は外した。
//   そのため、右手と下の段のキー番号（コンボの key-positions など）は roBa より 1 つ小さい
// - ノブは既定レイヤーで画面の拡大・縮小（roBa は縦スクロール）。LANG1 長押し中のタブ切り替えは roBa と同じ
// - ZMK が v0.3 系なので、roBa の実行時マクロ（&rmacro）と OS 別の既定レイヤーは無い
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// マウスのスクロール（&msc）を押した直後から一定の速さで送る（上流 moNa2 の設定のまま）
&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <19 20>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <23 24>;
        };
    };

    macros {
        // 非推奨の label の代わりにノード名を大文字にして、behavior の内部名を "TO_LAYER_0" のまま保つ。
        // 内部名が変わると、DYA Studio などで本体に保存した割り当てが解決できなくなる。
        // roBa はロックされたレイヤーを残す &to_keep を使うが、moNa2 の ZMK には OS レイヤーが無いので標準の &to でよい
        to_layer_0: TO_LAYER_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };

        // ノブ用: Ctrl を押したままホイールを 1 段回す（Ctrl＋ホイールと同じ、画面の拡大・縮小）。
        // Ctrl は左 Ctrl にする。使っている PC では PowerToys の Keyboard Manager で右 Ctrl を Insert に
        // 置き換えているので、右 Ctrl だと「Insert＋ホイール」になってただのスクロールになる。
        // &msc は押してから 16 ms ごとに「値 × 16 / 1000」段を送る。押している時間（tap-ms）を 24 ms にして、
        // 16 ms の 1 回だけ送らせる（値 100 なら 1.6 → 1 段）。ホイールを送り終えてから Ctrl を離す
        zoom_in: ZOOM_IN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <24>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc MOVE_Y(100)>
                , <&macro_release &kp LCTRL>
                ;
        };

        zoom_out: ZOOM_OUT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <24>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc MOVE_Y(-100)>
                , <&macro_release &kp LCTRL>
                ;
        };
    };

    behaviors {
        // ノブ（左手、クリック感なし、1 周 24 段）: DYA Studio でレイヤーごとに割り当てを変えられる。
        // cw-binding / ccw-binding は初期値で、Studio で保存した割り当てがあればそちらが使われる。
        // tap-ms は 1 段で割り当てを押している時間で、DYA Studio で新しく割り当てるときの Tap Time の初期値にもなる。
        // 右回り（cw）は、roBa のホイールを上に回したときと同じ向き（上スクロール・拡大・前のタブ）にそろえている

        // 既定レイヤー用: 画面の拡大・縮小
        rsr_zoom: rsr_zoom {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&zoom_in>;
            ccw-binding = <&zoom_out>;
        };

        // ARROW レイヤー（LANG1 長押し）用: タブ切り替え（roBa と同じ）
        rsr_tab: rsr_tab {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp LC(PAGE_UP)>;
            ccw-binding = <&kp LC(PAGE_DOWN)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // display-name の先頭にレイヤー番号を入れる。Studio で &mo や &lt のレイヤーを選ぶときに、
        // どの番号がどのレイヤーかを見分けるため。レイヤーを並べ替えたら番号も直す
        default_layer {
            display-name = "0 BASE";
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F        &kp G                          &kp EQUAL      &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B        &kp TAB           &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 LANG2  &lt 2 SPACE  &lt 3 LANG1       &kp BACKSPACE  &lt 1 ENTER                             &kp DEL
            >;

            sensor-bindings = <&rsr_zoom>;
        };

        FUNCTION {
            display-name = "1 FUNCTION";
            bindings = <
&trans     &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans         &trans             &trans
&kp TILDE  &kp DOLLAR       &kp PERCENT   &kp CARET             &trans                         &trans      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMICOLON  &kp SINGLE_QUOTE   &kp BACKSLASH
&kp GRAVE  &kp EXCLAMATION  &kp AT        &kp HASH              &trans                 &trans  &trans      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON      &kp DOUBLE_QUOTES  &kp PIPE
&trans     &trans           &trans        &trans                &trans                 &trans  &trans      &trans                                                                         &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };

        // roBa の左手内側 2 段目にあった Ctrl+Alt+0 は、moNa2 ではノブの位置なので外した
        NUM {
            display-name = "2 NUM";
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                &trans      &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                    &trans  &trans      &kp F4  &kp F5  &kp F6  &kp F11
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL         &trans  &kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F12
&trans                      &trans           &trans           &trans           &trans        &trans            &trans  &trans                              &kp F13
            >;

            sensor-bindings = <&rsr_trans>;
        };

        // 内側の TAB キーの位置に ESC を置く（roBa では既定レイヤーの ESC だったキーが、moNa2 ではノブになっているため）
        ARROW {
            display-name = "3 ARROW";
            bindings = <
&kp LG(LEFT_ARROW)  &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LG(RIGHT_ARROW)                      &kp LG(LEFT_ARROW)  &kp LS(LC(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LG(RIGHT_ARROW)
&kp HOME            &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END                          &trans  &kp HOME            &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END
&kp LEFT_SHIFT      &kp LG(LC(LEFT_ARROW))  &trans          &kp LG(LC(RIGHT_ARROW))  &trans               &kp ESCAPE  &trans  &trans              &kp LC(LG(LEFT_ARROW))  &trans          &kp LG(LC(RIGHT_ARROW))  &trans
&trans              &trans                  &trans          &trans                   &trans               &trans      &trans  &trans                                                                               &trans
            >;

            sensor-bindings = <&rsr_tab>;
        };

        // オートマウスで入るレイヤー。ここで &trans のキーを押すと、オートマウスはその場で解除される
        // （Ctrl・Win・Alt は例外で、解除されない）。&trans 以外を置いたキーでは解除されない。
        // J・K・L = 左・中・右クリック、M = 戻る、. = 進む。
        // Z と / は既定レイヤーと同じ割り当てを置き直している。長押しの Shift でオートマウスが
        // 解除されないようにして、Shift を押しながらクリックできるようにするため
        MOUSE {
            display-name = "4 MOUSE";
            bindings = <
&trans            &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans            &trans  &trans  &trans  &trans              &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&mt LEFT_SHIFT Z  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &mt LEFT_SHIFT SLASH
&trans            &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };

        // 使っていない（入るキーがない）。roBa とレイヤー番号をそろえるために残している
        SCROLL {
            display-name = "5 SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };

        layer_6 {
            display-name = "6 SYSTEM";
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp NUMBER_4  &trans        &trans        &trans              &trans       &studio_unlock  &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans          &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                    &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_trans>;
        };

        // roBa では接続先の OS に応じて自動で重ねる差分レイヤー。moNa2 の ZMK にはその機能が無いので、
        // 入るキーも無く使っていない。roBa とレイヤー番号をそろえるために残している
        os_layer {
            display-name = "7 OS";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };
    };
};
